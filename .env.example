# NoteWise AI - Environment Configuration
# Copy this file to .env and configure your GEMINI_API_KEY.

# =============================================================================
# 1. Gemini API Key (Required)
# =============================================================================
# Get your free Gemini API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# 2. Gemini Model Selection (Optional)
# =============================================================================
# Default: gemini-3.5-flash
# If you experience temporary 503 UNAVAILABLE errors (model overloaded during demand spikes),
# NoteWise AI automatically retries with exponential backoff and cascades through
# backup models. You can also explicitly configure your preferred model here:
#
# Verified Supported Models:
# - gemini-3.5-flash       : Recommended default. High speed, high stability.
# - gemini-3.5-flash-lite  : Ultra-low latency, lightweight, high availability.
# - gemini-3-flash-preview : Fast preview model with high uptime.
# - gemini-3.8-flash       : Advanced reasoning model (may experience periodic 503 spikes during peak traffic).
# - gemini-2.5-flash       : Standard fallback.
# - gemini-2.0-flash       : High throughput fallback.
# - gemini-1.5-flash       : Legacy fallback.
GEMINI_MODEL=gemini-3.5-flash

# Optional comma-separated list of custom fallback models to try before standard defaults:
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3-flash-preview

# =============================================================================
# 3. Retry and Exponential Backoff Settings (Optional)
# =============================================================================
# Configure safe retries for transient 503 (UNAVAILABLE), 429 (RATE LIMIT), and 5xx errors.
GEMINI_MAX_RETRIES=3
GEMINI_INITIAL_BACKOFF=1.5
GEMINI_BACKOFF_FACTOR=2.0
GEMINI_MAX_BACKOFF=8.0
GEMINI_TIMEOUT_SECONDS=20.0

# =============================================================================
# 4. Django Settings
# =============================================================================
DEBUG=True
SECRET_KEY=django-insecure-1lz1=)$3nzks4hf7+owldp%=*p#e(og=pu1z2(uppn&9ex%e#)
ALLOWED_HOSTS=127.0.0.1,localhost
